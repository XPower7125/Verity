<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VeritySafe</AssemblyName>
    <RootNamespace>VeritySafe</RootNamespace>
    <ApplicationIcon>..\..\verity.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\shared\*.cs" LinkBase="shared" />
    <EmbeddedResource Include="..\..\verity.ico" LogicalName="Verity.ico" />
    <EmbeddedResource Include="..\..\verity.png" LogicalName="Verity.png" />
  </ItemGroup>

</Project>